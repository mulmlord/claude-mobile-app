<?xml version="1.0" encoding="utf-8"?>
<!-- The token only travels encrypted: https:// to the laptop (tailscale serve with a
     Tailscale certificate). The one exception is pair-phone.sh in USB mode, which reaches the
     bridge at 127.0.0.1 through `adb reverse`: that never leaves the USB cable. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
